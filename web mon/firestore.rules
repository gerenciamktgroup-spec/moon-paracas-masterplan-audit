rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidLead(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32));
    }

    match /lots/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    match /dome_lots/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read: if true;
      allow create: if isValidLead(request.resource.data);
      allow update: if isValidLead(request.resource.data);
      allow delete: if false;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
