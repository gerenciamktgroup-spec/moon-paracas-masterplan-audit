rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /lots/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    match /dome_lots/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read, write: if false;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
