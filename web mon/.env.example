# Canonical production origin. Never include a trailing slash.
APP_URL="https://moon-paracas.vercel.app"
VITE_SITE_URL="https://moon-paracas.vercel.app"

# Keep disabled to show the provider-free local masterplan.
VITE_ENABLE_GOOGLE_MAPS="false"
# Required only when the Google map is explicitly enabled.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Public Mercado Pago key used by the Payment Brick in the browser.
VITE_MERCADO_PAGO_PUBLIC_KEY=

# Private Mercado Pago access token used only by /api endpoints.
MERCADO_PAGO_ACCESS_TOKEN=

# Webhook secret generated in Mercado Pago > Webhooks. Server only.
MERCADO_PAGO_WEBHOOK_SECRET=

# Firebase Admin service account as compact JSON or base64. Server only.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID="gen-lang-client-0913562980"
FIREBASE_DATABASE_ID="ai-studio-aeb12e28-f43d-4581-944f-d1882551d84e"

# Verified public contact channels. Do not publish placeholders.
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Verified legal identity shown in privacy/terms pages.
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_RUC=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_EMAIL=

# Same legal identity on the server; leads stay disabled until configured.
LEGAL_ENTITY_NAME=
PRIVACY_CONTACT_EMAIL=

# Optional CRM webhook. Payloads are signed with HMAC-SHA256 in X-Moon-Signature.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Enable Web Analytics and Speed Insights in the Vercel project dashboard after deploy.

# Never prefix private AI, cloud, Firebase Admin or payment secrets with VITE_.
